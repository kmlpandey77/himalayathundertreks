APP_NAME="Himalaya Thunder Treks"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://himalayathundertreks.test

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thundertreks
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Keep the pre-upgrade cookie name so the session cookie name doesn't change.
SESSION_COOKIE=laravel_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=sendmail
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -t -i"
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sales@himalayathundertreks.com"
MAIL_FROM_NAME="${APP_NAME}"

# Used only by `php artisan db:seed` to create the first admin user.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ipstack.com key used by App\IpLookUp
IPSTACK_ACCESS_KEY=
